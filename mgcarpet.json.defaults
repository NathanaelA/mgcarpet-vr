{
  "_readme": "The faithful baseline — every option at its authentic value, with ONE exception: gameplay.enhancement.prune_owned_jars defaults ON (a deliberate default-on enhancement). Generated by mgcarpet (delete to regenerate after upgrades). Put your overrides in mgcarpet.json with the same structure.",
  "audio": {
    "arrangement": "auto",
    "music": true,
    "music_volume": 1.0,
    "sfx_volume": 1.0,
    "sound": true,
    "speech": true,
    "subtitles": "auto"
  },
  "controls": {
    "models": {
      "altitude": "faithful",
      "thrust": "mc1"
    },
    "preferences": {
      "bindings": "classic",
      "fly_assistant": "auto",
      "invert_y": false,
      "mouse_sensitivity": 1.0
    }
  },
  "dev": {
    "plausible_spellbook": false
  },
  "gameplay": {
    "cheat": {
      "dev_spells": false,
      "invincible": false
    },
    "enhancement": {
      "prune_owned_jars": true,
      "spell_selector": "auto"
    }
  },
  "render": {
    "debug": {
      "crosshair": false,
      "grace_meter": false,
      "health_bars": false,
      "map_trigger_areas": false
    },
    "enhancement": {
      "expose_jar_spells": false,
      "hud_transparency": "mc1",
      "map_owned_buildings": false,
      "smooth_shading": false
    },
    "preference": {
      "fog_distance": 20,
      "light_sources": true,
      "reflections": true,
      "sky": true
    }
  },
  "sim": {
    "options": {},
    "parameters": {
      "awake_range": null,
      "entity_pool_size": null
    }
  }
